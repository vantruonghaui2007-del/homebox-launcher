<?xml version="1.0" encoding="utf-8"?>
<!-- Home bản dọc cho điện thoại: hai ô chính xếp chồng. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                style="@style/HomeText.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xin chào" />

            <TextView
                style="@style/HomeText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HomeBox" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/net_chip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="16dp">

            <ImageView
                android:id="@+id/net_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_wifi" />

            <TextView
                android:id="@+id/net_text"
                style="@style/HomeText.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:singleLine="true"
                android:text="Đang kiểm tra mạng" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:gravity="right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/date"
                style="@style/HomeText.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/tile_karaoke"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_karaoke"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="150dp"
            android:orientation="horizontal"
            android:paddingLeft="32dp"
            android:paddingRight="28dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_mic_big" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Karaoke"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_tile"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/karaoke_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="HomeKara"
                    android:textColor="#E6FFFFFF"
                    android:textSize="@dimen/text_action" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="@dimen/gap" />
        <LinearLayout
            android:id="@+id/tile_youtube"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_youtube"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="150dp"
            android:orientation="horizontal"
            android:paddingLeft="32dp"
            android:paddingRight="28dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_play_big" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="YouTube"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_tile"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/youtube_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Đang tìm ứng dụng"
                    android:textColor="#E6FFFFFF"
                    android:textSize="@dimen/text_action" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/fav_header"
        style="@style/HomeText.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Ứng dụng yêu thích" />

    <LinearLayout
        android:id="@+id/fav_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <include android:id="@+id/fav0" layout="@layout/item_favorite" />
        <include android:id="@+id/fav1" layout="@layout/item_favorite" />
        <include android:id="@+id/fav2" layout="@layout/item_favorite" />
        <include android:id="@+id/fav3" layout="@layout/item_favorite" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_apps"
            style="@style/HomeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_apps"
            android:text="Ứng dụng" />
        <TextView
            android:id="@+id/btn_network"
            style="@style/HomeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="12dp"
            android:drawableLeft="@drawable/ic_wifi"
            android:text="Mạng" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_settings"
            style="@style/HomeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_settings"
            android:text="Cài đặt" />
        <TextView
            android:id="@+id/btn_edit"
            style="@style/HomeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="12dp"
            android:drawableLeft="@drawable/ic_edit"
            android:text="Sửa yêu thích" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
